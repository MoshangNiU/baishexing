# 高德地图 Web服务 API Key（必填）
AMAP_KEY=your_amap_key_here

# 阿里云 OSS 配置（选填，不上传图片可不填）
OSS_ACCESS_KEY_ID=your_oss_key_id
OSS_ACCESS_KEY_SECRET=your_oss_key_secret
OSS_BUCKET_NAME=baishexing
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_DOMAIN=https://baishexing-images.oss-cn-hangzhou.aliyuncs.com

# JWT 密钥（选填，不填使用默认值）
JWT_SECRET=yunlan-jwt-secret-prod-change-this-to-random-string
